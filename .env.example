# Copia a backend/.env y ajusta los valores.
# Fuera de Docker lo lee @nestjs/config; dentro, lo inyecta Compose
# tanto al backend como al contenedor de Postgres.

NODE_ENV=development
PORT=3000

# --- Conexion que usa TypeORM ---
# DB_HOST es "db" dentro de Compose y "localhost" si corres Nest en el host.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce

# --- Credenciales con las que arranca el contenedor de Postgres ---
# La imagen oficial solo entiende estos nombres. Deben coincidir con los
# tres valores DB_ de arriba, por eso viven en el mismo archivo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# Origen permitido por CORS. En produccion nginx hace de proxy y sobra.
CORS_ORIGIN=http://localhost:5173

# --- JWT (CU01 Gestionar Sesion) ---
JWT_SECRET=change_me_super_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Seed inicial (npm run seed) ---
SEED_ADMIN_EMAIL=admin@fashionstore.com
SEED_ADMIN_PASSWORD=Admin123!
# Superadmin de la plataforma (SaaS): crea y suspende empresas desde /plataforma.
# Vacios = no se crea. Usa una contrasena fuerte en produccion.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- Cifrado de credenciales de metodos de pago (CU16) ---
# Clave de 32 bytes en hexadecimal (64 caracteres) para AES-256-GCM.
# Genera una con: openssl rand -hex 32
PAGOS_ENCRYPTION_KEY=change_me_64_hex_chars

# --- URL publica del frontend (Stripe vuelve aqui tras autorizar el pago) ---
FRONTEND_URL=http://localhost:5173

# --- Pagos simulados (QR y tarjeta, sin pasarela real) ---
# Solo para demostracion: aprueba el pago sin cobrar. En produccion dejalo en false.
PAGOS_SIMULADOS=true

# --- Stripe Checkout (checkout del carrito y anticipo de reservas, CU14) ---
# Llave secreta del dashboard de Stripe (Developers > API keys): sk_test_... en pruebas, sk_live_... en produccion.
# Vacia = Stripe no se ofrece. La llave publicable (pk_...) no hace falta: el pago es en la pagina de Stripe.
STRIPE_SECRET_KEY=
# Moneda de cobro: se cobra el equivalente del total en Bs (monto = total en Bs / STRIPE_BOB_RATE).
STRIPE_CURRENCY=usd
STRIPE_BOB_RATE=6.96

# --- Notificaciones push (Expo Push Service) ---
# false: las notificaciones solo se guardan en BD, sin llamar a Expo.
PUSH_ENABLED=true
# Opcional: access token de expo.dev, solo si activas "enhanced security" para push en EAS.
PUSH_ACCESS_TOKEN=

# --- Reportes generativos con IA (CU18) ---
# API key de Google AI Studio (gratuita dentro de su cuota): https://aistudio.google.com/apikey
# Vacio = los reportes generativos caen al interprete por palabras clave (regex), sin IA.
GEMINI_API_KEY=
# Opcional: modelo de Gemini a usar. Los modelos "-flash" grandes (ej. 3.8-flash)
# suelen devolver 503 "high demand" por saturacion; "-flash-lite" es mas liviano,
# menos pedido y de sobra para esta clasificacion/extraccion.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- BI: inteligencia de negocio ---
# Quien atiende al agente: auto (Vertex si hay GOOGLE_CLOUD_PROJECT, si no GEMINI_API_KEY), vertex o api-key.
BI_IA_PROVEEDOR=auto
# Opcional: modelo del agente del BI. Vacio = GEMINI_MODEL.
BI_GEMINI_MODEL=
# Vertex AI (opcional): proyecto y region de Google Cloud. Las credenciales NO van aqui: se toman de
# GOOGLE_APPLICATION_CREDENTIALS = ruta a un JSON de cuenta de servicio guardado FUERA del repositorio.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Servicio de machine learning (Python, carpeta ml/) y la clave que comparten NestJS y ese servicio.
ML_URL=http://localhost:8000
ML_CLAVE_INTERNA=
# Carga nocturna del Data Warehouse (esquema dw). false = solo a pedido desde el BI.
BI_ETL_PROGRAMADO=true
BI_ETL_CRON=0 2 * * *

# --- Multiempresa (SaaS) ---
# Empresa (slug) que se usa cuando un request no trae el header X-Empresa ni un
# token con empresa. Mantiene funcionando al frontend y la app movil mientras no
# manden el header. Vacio = X-Empresa obligatorio en las rutas de cada tienda.
TENANT_SLUG_POR_DEFECTO=fashionstore
