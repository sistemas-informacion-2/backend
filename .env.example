# Copia a backend/.env y ajusta los valores.
# Fuera de Docker lo lee @nestjs/config; dentro, lo inyecta Compose
# tanto al backend como al contenedor de Postgres.

NODE_ENV=development
PORT=3000

# --- Conexion que usa TypeORM ---
# DB_HOST es "db" dentro de Compose y "localhost" si corres Nest en el host.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce

# --- Credenciales con las que arranca el contenedor de Postgres ---
# La imagen oficial solo entiende estos nombres. Deben coincidir con los
# tres valores DB_ de arriba, por eso viven en el mismo archivo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# Origen permitido por CORS. En produccion nginx hace de proxy y sobra.
CORS_ORIGIN=http://localhost:5173

# --- JWT (CU01 Gestionar Sesion) ---
JWT_SECRET=change_me_super_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Seed inicial (npm run seed) ---
SEED_ADMIN_EMAIL=admin@fashionstore.com
SEED_ADMIN_PASSWORD=Admin123!

# --- Cifrado de credenciales de metodos de pago (CU16) ---
# Clave de 32 bytes en hexadecimal (64 caracteres) para AES-256-GCM.
# Genera una con: openssl rand -hex 32
PAGOS_ENCRYPTION_KEY=change_me_64_hex_chars

# --- URL publica del frontend (Stripe vuelve aqui tras autorizar el pago) ---
FRONTEND_URL=http://localhost:5173

# --- Pagos simulados (QR y tarjeta, sin pasarela real) ---
# Solo para demostracion: aprueba el pago sin cobrar. En produccion dejalo en false.
PAGOS_SIMULADOS=true

# --- Stripe Checkout (checkout del carrito y anticipo de reservas, CU14) ---
# Llave secreta del dashboard de Stripe (Developers > API keys): sk_test_... en pruebas, sk_live_... en produccion.
# Vacia = Stripe no se ofrece. La llave publicable (pk_...) no hace falta: el pago es en la pagina de Stripe.
STRIPE_SECRET_KEY=
# Moneda de cobro: se cobra el equivalente del total en Bs (monto = total en Bs / STRIPE_BOB_RATE).
STRIPE_CURRENCY=usd
STRIPE_BOB_RATE=6.96

# --- Notificaciones push (Expo Push Service) ---
# false: las notificaciones solo se guardan en BD, sin llamar a Expo.
PUSH_ENABLED=true
# Opcional: access token de expo.dev, solo si activas "enhanced security" para push en EAS.
PUSH_ACCESS_TOKEN=
